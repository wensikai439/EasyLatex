<Window x:Class="EasyLatex.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit" Title="EasyLatex" Width="1280" Height="840" MinWidth="960" MinHeight="620" Foreground="{DynamicResource Ink}" Background="{DynamicResource Surface}" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" Closing="Window_Closing">
  <Grid Background="{DynamicResource Surface}">
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,10">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Border Background="{DynamicResource Accent}" CornerRadius="9" Width="34" Height="34" Margin="0,0,10,0"><TextBlock Text="E" Foreground="White" FontFamily="Georgia" FontSize="23" HorizontalAlignment="Center"/></Border>
          <TextBlock Text="EasyLatex" FontSize="18" FontWeight="SemiBold" Margin="0,0,20,0"/>
          <Menu VerticalAlignment="Center"><MenuItem Header="文件"><MenuItem Header="新建文档" InputGestureText="Ctrl+N" Click="New_Click"/><MenuItem Header="中文论文模板" Click="ChineseTemplate_Click"/><MenuItem Header="演示文稿模板" Click="BeamerTemplate_Click"/><Separator/><MenuItem Header="打开文件…" InputGestureText="Ctrl+O" Click="Open_Click"/><MenuItem Header="打开项目文件夹…" Click="OpenFolder_Click"/><MenuItem x:Name="RecentMenu" Header="最近打开"/><Separator/><MenuItem Header="保存" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="另存为…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/><MenuItem Header="导出 PDF…" Click="Export_Click"/></MenuItem><MenuItem Header="编辑"><MenuItem Header="查找 / 替换" InputGestureText="Ctrl+F / Ctrl+H" Click="Find_Click"/><MenuItem Header="注释 / 取消注释" InputGestureText="Ctrl+/" Click="Comment_Click"/><MenuItem Header="源码定位到 PDF" InputGestureText="Ctrl+J" Click="ForwardSearch_Click"/></MenuItem><MenuItem Header="视图"><MenuItem Header="大纲与文件" Click="ToggleSidebar_Click"/><MenuItem Header="专注写作" InputGestureText="F11" Click="Focus_Click"/><MenuItem Header="切换明暗主题" Click="Theme_Click"/></MenuItem><MenuItem Header="帮助"><MenuItem Header="快捷键" Click="Shortcuts_Click"/><MenuItem Header="关于 EasyLatex" Click="About_Click"/></MenuItem></Menu>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="AutoCompile" Content="自动编译" ToolTip="开启后，停止输入会自动保存文件并编译" Checked="AutoCompile_Changed" Unchecked="AutoCompile_Changed"/>
          <Button x:Name="CompileButton" Content="编译  Ctrl+Enter" Style="{StaticResource Primary}" Click="Compile_Click" AutomationProperties.Name="保存并编译" Margin="8,0,8,0"/>
          <Button Content="✦ AI" Click="ToggleAi_Click" ToolTip="按需解释错误、修复语法与润色选区"/>
          <Button Content="⚙" FontSize="19" Click="Settings_Click" AutomationProperties.Name="设置" ToolTip="写作、编译与 AI 设置"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="Sidebar" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Grid Margin="12,18,12,8"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="大纲" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="8,0"/>
          <ListBox Grid.Row="1" x:Name="OutlineList" SelectionChanged="Outline_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
          <DockPanel Grid.Row="2"><Button DockPanel.Dock="Right" Content="↻" Padding="6,3" Click="RefreshProject_Click" ToolTip="刷新项目文件"/><TextBlock Text="项目文件" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="8,0"/></DockPanel>
          <ListBox Grid.Row="3" x:Name="ProjectList" MouseDoubleClick="Project_DoubleClick"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="270"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="270"/></Grid.ColumnDefinitions>
        <Grid x:Name="EditorPane"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="DocumentTabs"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="4,3"><Button Style="{StaticResource DocumentTab}" Content="{Binding Title}" Tag="{Binding}" Click="Tab_Click" Padding="10,8"/><Button Content="×" Tag="{Binding}" Click="CloseTab_Click" Padding="5,5" AutomationProperties.Name="关闭文档"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
          <Border x:Name="FindBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Canvas}" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBox x:Name="FindText" ToolTip="查找文本" KeyDown="FindText_KeyDown"/><TextBox x:Name="ReplaceText" Margin="0,5,0,0" ToolTip="替换为"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="查找" Click="FindNext_Click"/><Button Content="替换" Click="Replace_Click"/><Button Content="全部" Click="ReplaceAll_Click"/><Button Content="×" Click="CloseFind_Click" AutomationProperties.Name="关闭查找"/></StackPanel></Grid></Border>
          <avalon:TextEditor x:Name="Editor" Grid.Row="2" FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI" FontSize="15" ShowLineNumbers="True" WordWrap="True" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" LineNumbersForeground="{DynamicResource Muted}" Padding="10,18,14,18" TextChanged="Editor_TextChanged" PreviewKeyDown="Editor_PreviewKeyDown" AutomationProperties.Name="LaTeX 源码编辑器"/>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Line}"/>
        <Grid x:Name="PreviewPane" Grid.Column="2" Background="{DynamicResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="{DynamicResource Surface}" Padding="12,3"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−" Click="ZoomOut_Click" Padding="8,5" AutomationProperties.Name="缩小预览"/><Button x:Name="ZoomLabel" Content="适合宽度" Click="FitWidth_Click" Padding="6,5" ToolTip="点击适合宽度；Ctrl+滚轮缩放"/><Button Content="+" Click="ZoomIn_Click" Padding="8,5" AutomationProperties.Name="放大预览"/><Button Content="↗" Click="Export_Click" ToolTip="导出 PDF" AutomationProperties.Name="导出 PDF"/></StackPanel><TextBlock x:Name="PreviewLabel" Text="PDF 预览" FontSize="12" Foreground="{DynamicResource Muted}"/></DockPanel></Border>
          <ListBox Grid.Row="1" x:Name="PdfPages" ItemsSource="{Binding Pages}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Pdf_MouseWheel" SizeChanged="Pdf_SizeChanged"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="10,12"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#DDDEE5" BorderThickness="1" Loaded="PdfPage_Loaded" DataContextChanged="PdfPage_DataContextChanged" MouseLeftButtonDown="PdfPage_Click" ToolTip="Ctrl+点击定位源码"><Grid><Image Source="{Binding Image}" Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill"/><Canvas IsHitTestVisible="False"><Border Canvas.Left="{Binding MarkerLeft}" Canvas.Top="{Binding MarkerTop}" Width="{Binding MarkerWidth}" Height="{Binding MarkerHeight}" Visibility="{Binding HasMarker, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Accent}" Opacity="0.28" CornerRadius="3"/></Canvas></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          <StackPanel x:Name="PreviewEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="从文字，到纸面。" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Ctrl+Enter 编译，PDF 就会出现在这里" Foreground="{DynamicResource Muted}" Margin="0,14" HorizontalAlignment="Center"/><TextBlock Text="你的文档保存在本机，AI 仅在你主动使用时连接。" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
        </Grid>
        <Border x:Name="AiPanel" Grid.ColumnSpan="3" HorizontalAlignment="Right" Width="400" Margin="0,0,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Visibility="Collapsed">
          <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="ToggleAi_Click" AutomationProperties.Name="关闭 AI 面板"/><TextBlock Text="✦ 写作助手" FontSize="17" FontWeight="SemiBold"/></DockPanel>
            <StackPanel Grid.Row="1"><TextBlock x:Name="AiScope" Text="主动发送内容，修改由你决定。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,10"/><WrapPanel><Button Content="修复语法" Click="AiFix_Click"/><Button Content="润色选区" Click="AiPolish_Click"/><Button Content="解释错误" Click="AiExplain_Click"/></WrapPanel><TextBox x:Name="AiPrompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,12,0,10" Text="修复当前 LaTeX 编译错误，尽量少改动原文。"/><StackPanel Orientation="Horizontal"><Button x:Name="AiSendButton" Content="发送给 AI" Style="{StaticResource Primary}" Click="AiSend_Click"/><Button x:Name="AiCancelButton" Content="取消" Click="AiCancel_Click" Visibility="Collapsed"/><Button Content="API 设置" Click="Settings_Click"/></StackPanel></StackPanel>
            <TextBlock Grid.Row="2" x:Name="AiStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12"/>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="AiExplanation" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock x:Name="AiBeforeLabel" Text="修改前" FontWeight="SemiBold" Visibility="Collapsed"/><TextBox x:Name="AiBefore" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" MaxHeight="220" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,6,0,14"/><TextBlock x:Name="AiAfterLabel" Text="修改后" FontWeight="SemiBold" Visibility="Collapsed"/><TextBox x:Name="AiAfter" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" MaxHeight="260" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,6,0,14"/></StackPanel></ScrollViewer>
            <Button Grid.Row="4" x:Name="AiApplyButton" Content="应用修改并验证编译" Style="{StaticResource Primary}" Click="AiApply_Click" Visibility="Collapsed"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border x:Name="DiagnosticsPanel" Grid.Row="2" Visibility="Collapsed" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface}"><Grid Margin="18,8"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="×" Click="CloseDiagnostics_Click" AutomationProperties.Name="收起编译信息"/><Button DockPanel.Dock="Right" Content="✦ 尝试修复" Click="AiFix_Click"/><TextBlock x:Name="DiagnosticsTitle" Text="编译信息" FontWeight="SemiBold"/></DockPanel><ListBox Grid.Row="1" x:Name="DiagnosticsList" MaxHeight="150" MouseDoubleClick="Diagnostic_DoubleClick"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock DockPanel.Dock="Left" Text="{Binding Location}" Foreground="{DynamicResource Muted}" Width="160" Margin="0,0,12,0"/><TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Expander Grid.Row="2" Header="原始日志" Margin="8,4"><TextBox x:Name="BuildLog" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Height="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Expander></Grid></Border>
    <Border Grid.Row="3" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="CaretStatus" Text="第 1 行 · UTF-8" Foreground="{DynamicResource Muted}" FontSize="11" Margin="12,0"/><TextBlock x:Name="EngineStatus" Text="自动引擎" Foreground="{DynamicResource Muted}" FontSize="11"/><Button Content="日志" Click="ToggleDiagnostics_Click" Padding="8,2" FontSize="11"/></StackPanel><TextBlock x:Name="StatusText" Text="准备就绪" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid>
</Window>
