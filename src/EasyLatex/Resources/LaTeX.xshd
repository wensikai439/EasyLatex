<?xml version="1.0"?>
<SyntaxDefinition name="LaTeX" extensions=".tex;.sty;.cls;.bib" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#8B91A3" fontStyle="italic"/>
  <Color name="Command" foreground="#7657BD"/>
  <Color name="Math" foreground="#278C88"/>
  <Color name="Bracket" foreground="#D47B37"/>
  <RuleSet>
    <Span color="Comment" begin="(?&lt;!\\)%"/>
    <Span color="Math" begin="(?&lt;!\\)\$\$" end="\$\$" multiline="true"/>
    <Span color="Math" begin="(?&lt;!\\)\$" end="(?&lt;!\\)\$"/>
    <Span color="Math" begin="\\\[" end="\\\]" multiline="true"/>
    <Span color="Math" begin="\\\(" end="\\\)" multiline="true"/>
    <Rule color="Command">\\(?:[a-zA-Z@]+\*?|.)</Rule>
    <Rule color="Bracket">[{}\[\]]</Rule>
  </RuleSet>
</SyntaxDefinition>
