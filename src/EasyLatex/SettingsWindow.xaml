<Window x:Class="EasyLatex.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EasyLatex 设置" Width="560" Height="570" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions><TextBlock Text="把工作台调成你的习惯" FontSize="21" FontWeight="SemiBold"/>
    <TabControl Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}">
      <TabItem Header="写作"><StackPanel Margin="18"><TextBlock Text="编辑字号"/><Slider x:Name="FontSizeSlider" Minimum="11" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12"/><TextBlock Text="自动编译" Margin="0,16,0,10"/><CheckBox x:Name="AutoCompileCheck" Content="停止输入后自动保存并编译"/><TextBlock Text="手动编译快捷键是 Ctrl+Enter。自动编译仅作用于已保存的文档。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="8,12,0,0"/><CheckBox x:Name="DarkCheck" Content="深色写作界面" Margin="8,24,0,0"/></StackPanel></TabItem>
      <TabItem Header="编译"><StackPanel Margin="18"><TextBlock Text="编译引擎"/><ComboBox x:Name="EngineCombo"/><TextBlock Text="TeX 工具所在文件夹（可留空自动查找）" Margin="0,18,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="选择…" Click="BrowseCompiler_Click"/><TextBox x:Name="CompilerPath"/></DockPanel><TextBlock x:Name="DetectedTools" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12"/><CheckBox x:Name="ShellEscapeCheck" Content="允许 TeX 执行外部命令（shell-escape）" Margin="8,16,0,0"/><TextBlock Text="常规写作无需开启。部分 TikZ / minted 项目需要这个选项。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="8,10,0,14"/><Button Content="安装轻量编译引擎" Click="InstallEngine_Click" HorizontalAlignment="Left"/><TextBlock x:Name="InstallStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10"/></StackPanel></TabItem>
      <TabItem Header="AI 助手"><StackPanel Margin="18"><TextBlock Text="兼容 OpenAI 的 API 根地址"/><TextBox x:Name="EndpointText" Margin="0,8,0,14"/><TextBlock Text="模型名称"/><TextBox x:Name="ModelText" Margin="0,8,0,14"/><TextBlock Text="API 密钥"/><PasswordBox x:Name="ApiKeyBox" Padding="8" Margin="0,8,0,4"/><DockPanel><Button DockPanel.Dock="Right" Content="删除已保存密钥" Click="DeleteKey_Click" Padding="5,6"/><TextBlock x:Name="KeyStatus" Foreground="{DynamicResource Muted}" FontSize="11"/></DockPanel><TextBlock Text="AI 是可选功能。只有点击发送时，才会将选区或当前文件及错误信息发送到这个服务。密钥保存到 Windows 凭据管理器，本机模型可以留空。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12"/></StackPanel></TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="取消" IsCancel="True"/><Button Content="保存设置" Style="{StaticResource Primary}" Click="Save_Click" IsDefault="True"/></StackPanel>
  </Grid>
</Window>
